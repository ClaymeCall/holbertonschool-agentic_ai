# .env.example
# Exemple de variables d'environnement pour le projet
# Renommez ce fichier en .env et complétez les valeurs.

# Chemin du fichier tasks.json (monté en volume dans le conteneur)
TASKS_FILE=./tasks.json

# Exemple de variables pour une base de données (si applicable)
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=appuser
# DB_PASSWORD=changeme
# DB_NAME=mydb

# Exemple de clé API (si applicable)
# API_KEY=your_api_key_here